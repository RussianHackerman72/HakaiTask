# Salin file ini jadi .env.local (yang asli di-gitignore).
# Kunci publishable memang aman dipajang di client — data dilindungi RLS,
# bukan oleh kerahasiaan kunci ini. Jangan pernah taruh service_role key di sini.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
