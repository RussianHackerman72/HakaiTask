# Metro gak bisa jalan di atas node_modules ketat ala pnpm: dia butuh bisa
# nemu transformer-nya sendiri lewat penelusuran folder biasa. Di mesin lokal
# kebetulan lolos, tapi di mesin EAS yang install-nya dari nol, bundling rilis
# mati di modul pertama — "Cannot read properties of undefined (reading
# 'transformFile')", alias transformer-nya gak pernah kebentuk.
#
# Ini juga syarat resmi Expo buat monorepo pnpm.
node-linker=hoisted
