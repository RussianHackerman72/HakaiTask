<?xml version="1.0" encoding="utf-8"?>
<!--
  Sengaja SESEMPIT mungkin:
  - cuma TYPE_WINDOW_STATE_CHANGED, gak nguping isi layar
  - gak minta canRetrieveWindowContent
  Yang dibutuhin cuma satu info: nama paket yang lagi di depan.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeWindowStateChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:notificationTimeout="100"
  android:canRetrieveWindowContent="false"
  android:description="@string/focus_guard_accessibility_desc" />
